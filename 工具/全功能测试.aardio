//========== 模块11：20年检验节点（自产权登记日起） ==========
//与主程序 buildResult 的 hist 规则一致：收 n<=20 的全部节点（含未到期），区间 = 登记日 ~ 登记日+20年
var histNodes = function(regStr){
	var reg = parseDate(regStr);
	if(!reg) return null;
	var end = mkTime(reg,20);
	var spec = {2;4;6;8;10};
	var list = {};
	for(i=1;#spec;1){
		var d = mkTime(reg,spec[i]);
		if( spec[i] <= 20 and tonumber(d) <= tonumber(end) ) table.push(list,spec[i]);
	}
	for(n=11;60;1){
		var d = mkTime(reg,n);
		if( n <= 20 and tonumber(d) <= tonumber(end) ) table.push(list,n);
	}
	return list;
}
var nowFix = time("2026/10/31","%Y/%m/%d");
var hOld = histNodes("2014-01-10");
$.expect( #hOld, 15, "M11 2014登记车 20年节点共15个" );
$.expect( hOld[1], 2, "M11 首节点=第2年（登记日起算）" );
$.expect( hOld[#hOld], 20, "M11 末节点=第20年" );
var hNew = histNodes("2023-11-22");
$.expect( #hNew, 15, "M11 新车同样15个节点(含未到期)" );
$.expect( fmtDate(mkTime(parseDate("2014-01-10"),20)), "2034-01-10", "M11 第20年截止日=登记日+20年" );
$.test( #histNodes("2000-01-01") == 15, "M11 超20年车仍截断在第20年" );

//========== 汇总 ==========
return $.report();
